{
  "name": "@rolldown/notify",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "imports": {
    "#binding": {
      "types": "./dist/binding.d.ts",
      "import": "./dist/binding.mjs",
      "default": "./dist/binding.mjs"
    },
    "#index": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./chokidar": {
      "types": "./dist/chokidar.d.mts",
      "import": "./dist/chokidar.mjs",
      "default": "./dist/chokidar.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:native && pnpm run build:js",
    "build:js": "tsdown",
    "build:native": "napi build --platform --release --output-dir dist --esm --js binding.mjs --dts binding.d.ts",
    "build:wasi": "pnpm run build:native --target wasm32-wasip1-threads",
    "test": "pnpm run build && node --test test/*.test.cjs",
    "test:wasi": "pnpm run build:wasi && pnpm run build:js && node --test --require ./test/force-wasi.cjs test/*.test.cjs",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.0",
    "@types/node": "^24.19.2",
    "emnapi": "2.0.0-alpha.4",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-alpha.4",
    "@emnapi/runtime": "2.0.0-alpha.4",
    "@napi-rs/wasm-runtime": "~1.2.5"
  },
  "napi": {
    "binaryName": "rolldown_notify"
  }
}
