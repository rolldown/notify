{
  "name": "@rolldown/notify",
  "version": "0.0.2",
  "description": "Native file watching for Node.js, powered by rolldown-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolldown/notify.git",
    "directory": "notify-napi"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.14.0",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./chokidar": "./dist/chokidar.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:native && pnpm run build:js",
    "build:js": "tsdown",
    "build:native": "napi build --platform --release --output-dir dist --esm --js binding.mjs --dts binding.d.mts",
    "build:wasi": "pnpm run build:native --target wasm32-wasip1-threads",
    "test": "pnpm run build && vitest run",
    "test:wasi": "pnpm run build:wasi && pnpm run build:js && vitest run --mode wasi",
    "typecheck": "tsc && tsc -p tsconfig.config.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.19.2",
    "emnapi": "2.0.0-alpha.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@emnapi/core": "2.0.0-alpha.4",
    "@emnapi/runtime": "2.0.0-alpha.4",
    "@napi-rs/wasm-runtime": "~1.2.5"
  },
  "napi": {
    "binaryName": "rolldown_notify",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "wasm32-wasip1-threads",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ],
    "wasm": {
      "optionalDependency": true
    }
  }
}
